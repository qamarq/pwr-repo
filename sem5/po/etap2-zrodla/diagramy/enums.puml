  odrzucenie
}
enum Rola {
  osobaDokonujacaPowierzen
  prowadzacy
  pracownikDzialuKsztalcenia
  administrator
}
RodzajZajec -[hidden]> RodzajSemestru
RodzajSemestru -[hidden]> StopienStudiow
StopienStudiow -[hidden]> FormaStudiow
FormaStudiow -[hidden]> StatusPlanu
RodzajZajec -[hidden]-> GrupaPracownicza
GrupaPracownicza -[hidden]> Stanowisko
Stanowisko -[hidden]> PodstawaZnizki
PodstawaZnizki -[hidden]> StatusZgloszenia
StatusZgloszenia -[hidden]> Rola
GrupaPracownicza -[hidden]-> StatusPropozycji
StatusPropozycji -[hidden]> RodzajOdpowiedzi
RodzajOdpowiedzi -[hidden]> KanalOdpowiedzi
KanalOdpowiedzi -[hidden]> ZadanieZmiany
ZadanieZmiany -[hidden]> SposobRozwiazania
@enduml
