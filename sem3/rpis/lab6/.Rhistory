# Laboratorium 6 – Zadania 2–8
dane <- read.csv("waga1.csv", sep = ";")
# ===============================
# Zadanie 2
# Test Z – różnica średnich wzrostu
# ===============================
# Dane z treści
mean_k <- 166; var_k <- 100; n_k <- 520
mean_m <- 174; var_m <- 121; n_m <- 480
Z <- (mean_k - mean_m) / sqrt(var_k/n_k + var_m/n_m)
p_value <- 2 * (1 - pnorm(abs(Z)))
# H0: średni wzrost nie zależy od płci
# H1: średni wzrost zależy od płci
p_value
# ===============================
# Zadanie 3
# t.test – średni przyrost = 2 kg
# ===============================
dane$przyrost <- dane$Waga_po - dane$Waga_przed
t.test(dane$przyrost, mu = 2)
# H0: średni przyrost masy = 2 kg
# H1: średni przyrost masy ≠ 2 kg
# ===============================
# Zadanie 4
# Proporcja >70kg po studiach (kobiety vs mężczyźni)
# ===============================
dane$ponad70 <- dane$Waga_po > 70
tab70 <- table(dane$plec, dane$ponad70)
prop.test(tab70)
# H0: proporcje są równe
# H1: proporcje są różne
# ===============================
# Zadanie 5
# Test: mężczyźni są o 5cm wyżsi
# ===============================
t.test(Wzrost ~ plec, data = dane, mu = -5)
# H0: różnica średnich = 5 cm
# H1: różnica średnich ≠ 5 cm
# ===============================
# Zadanie 6
# 80% studentów przybiera na wadze
# ===============================
przytyl <- dane$przyrost > 0
prop.test(sum(przytyl), length(przytyl), p = 0.8)
# H0: p = 0.8
# H1: p ≠ 0.8
# ===============================
# Zadanie 7
# Mężczyźni średnio +4kg
# ===============================
t.test(dane$przyrost[dane$plec == 0], mu = 4)
# H0: średni przyrost = 4 kg
# H1: średni przyrost ≠ 4 kg
