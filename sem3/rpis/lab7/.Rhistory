####################################################
## LABORATORIUM 7 – TESTY ZGODNOŚCI, REGRESJA
####################################################
####################################################
## 1. TEST ZGODNOŚCI CHI-KWADRAT – KOSTKA
####################################################
obs <- c(171,200,168,213,226,222)
n <- sum(obs)
exp <- rep(n/6,6)
chi_stat <- sum((obs-exp)^2/exp)
p_chi <- 1 - pchisq(chi_stat, df=5)
chisq.test(obs, p=rep(1/6,6))
# H0: kostka jest symetryczna
# H1: kostka nie jest symetryczna
# p =
p_chi
####################################################
## 2. TEST KOLMOGOROWA-SMIRNOWA
####################################################
set.seed(123)
## a)
x <- rexp(1000, rate=1)
## b.i)
ks_norm_exp <- ks.test(x, "pnorm", mean=1, sd=1)
# H0: próba pochodzi z N(1,1)
# H1: próba nie pochodzi z N(1,1)
# p =
ks_norm_exp$p.value
## b.ii)
ks_exp <- ks.test(x, "pexp", rate=1)
# H0: próba pochodzi z Exp(1)
# H1: próba nie pochodzi z Exp(1)
# p =
ks_exp$p.value
## c)
y <- rgamma(1000, shape=100, scale=1)
## d.i)
ks_norm_gamma <- ks.test(y, "pnorm", mean=100, sd=10)
# H0: próba pochodzi z N(100,10)
# H1: próba nie pochodzi z N(100,10)
# p =
ks_norm_gamma$p.value
## d.ii)
ks_gamma <- ks.test(y, "pgamma", shape=100, scale=1)
# H0: próba pochodzi z Gamma(100,1)
# H1: próba nie pochodzi z Gamma(100,1)
# p =
ks_gamma$p.value
####################################################
## 3. TESTY NORMALNOŚCI – MIESZKANIA
####################################################
m <- read.csv("mieszkania.csv", header=TRUE)
m$cena_m2 <- m$Cena / m$Metraz
# ============================================================================
# Rachunek Prawdopodobieństwa i Statystyka - Laboratorium 7
# Testy Zgodności, Regresja Liniowa
# ============================================================================
# Funkcja do oceny wartości p
wniosek_p <- function(p){
if(p > 0.05){
cat("p >", p, "-> nie odrzucamy H0, brak dowodow przeciwko H0\n")
} else if(p > 0.01){
cat("0.01 < p <= 0.05 -> odrzucamy H0, mamy dowody przeciwko H0\n")
} else if(p > 0.001){
cat("0.001 < p <= 0.01 -> odrzucamy H0, mamy mocne dowody przeciwko H0\n")
} else {
cat("p <= 0.001 -> odrzucamy H0, bardzo mocne dowody przeciwko H0\n")
}
}
# Wczytanie danych
mieszkania <- read.csv("mieszkania.csv")
bakteria <- read.csv("bakteria.csv")
cat(paste(rep("=", 80), collapse = ""), "\n")
cat("ZADANIE 1: Test zgodności chi-kwadrat dla kostki\n")
cat(paste(rep("=", 80), collapse = ""), "\n\n")
# Dane z rzutów kostką
wyniki <- c(1, 2, 3, 4, 5, 6)
obserwowane <- c(171, 200, 168, 213, 226, 222)
n <- sum(obserwowane)
cat("Obserwowane frekwencje:\n")
print(data.frame(Wynik = wyniki, Frekwencja = obserwowane))
cat("\n")
# a) Tablica oczekiwanych frekwencji (kostka symetryczna)
oczekiwane <- rep(n/6, 6)
cat("a) Oczekiwane frekwencje (kostka symetryczna):\n")
print(data.frame(Wynik = wyniki, Oczekiwane = oczekiwane))
cat("\n")
# b) Realizacja statystyki testowej
statystyka <- sum((obserwowane - oczekiwane)^2 / oczekiwane)
cat("b) Realizacja statystyki chi-kwadrat:\n")
cat("   χ² =", statystyka, "\n\n")
# c) Wartość p
df <- length(wyniki) - 1  # stopnie swobody
p_wartosc <- 1 - pchisq(statystyka, df)
cat("c) Wartość p:\n")
cat("   p =", p_wartosc, "\n\n")
# d) Wniosek
cat("d) Wniosek:\n")
cat("   H0: Kostka jest symetryczna (wszystkie wyniki równie prawdopodobne)\n")
cat("   H1: Kostka nie jest symetryczna\n")
cat("   p =", round(p_wartosc, 4), "\n   ")
wniosek_p(p_wartosc)
cat("\n")
# e) Test za pomocą chisq.test
cat("e) Test za pomocą funkcji chisq.test:\n")
test_wynik <- chisq.test(obserwowane)
print(test_wynik)
cat("\n\n")
cat(paste(rep("=", 80), collapse = ""), "\n")
cat("ZADANIE 2: Test Kołmogorowa-Smirnowa\n")
cat(paste(rep("=", 80), collapse = ""), "\n\n")
# Ustawienie ziarna dla powtarzalności
set.seed(123)
# a) Generowanie próby z rozkładu wykładniczego
cat("a) Generowanie 1000 realizacji z rozkładu wykładniczego Exp(1):\n")
proba_exp <- rexp(1000, rate = 1)
cat("   Średnia próby:", mean(proba_exp), "\n")
cat("   Odchylenie standardowe:", sd(proba_exp), "\n\n")
# b) Testy KS dla próby wykładniczej
cat("b) Testy Kołmogorowa-Smirnowa dla próby wykładniczej:\n\n")
cat("   i) Test zgodności z rozkładem normalnym N(1,1):\n")
test_ks_norm <- ks.test(proba_exp, "pnorm", mean = 1, sd = 1)
print(test_ks_norm)
cat("\n   H0: Próba pochodzi z rozkładu normalnego N(1,1)\n")
cat("   H1: Próba nie pochodzi z rozkładu normalnego N(1,1)\n")
cat("   p =", round(test_ks_norm$p.value, 6), "\n   ")
wniosek_p(test_ks_norm$p.value)
cat("\n")
cat("   ii) Test zgodności z rozkładem wykładniczym Exp(1):\n")
test_ks_exp <- ks.test(proba_exp, "pexp", rate = 1)
print(test_ks_exp)
cat("\n   H0: Próba pochodzi z rozkładu wykładniczego Exp(1)\n")
cat("   H1: Próba nie pochodzi z rozkładu wykładniczego Exp(1)\n")
cat("   p =", round(test_ks_exp$p.value, 4), "\n   ")
wniosek_p(test_ks_exp$p.value)
cat("\n\n")
# c) Generowanie próby z rozkładu Gamma
cat("c) Generowanie 1000 realizacji z rozkładu Gamma(100, 1):\n")
proba_gamma <- rgamma(1000, shape = 100, scale = 1)
cat("   Średnia próby:", mean(proba_gamma), "\n")
cat("   Odchylenie standardowe:", sd(proba_gamma), "\n")
cat("   (Teoretyczne wartości: E[X]=100, SD[X]=10)\n\n")
# d) Testy KS dla próby Gamma
cat("d) Testy Kołmogorowa-Smirnowa dla próby Gamma:\n\n")
cat("   i) Test zgodności z rozkładem normalnym N(100,10):\n")
test_ks_gamma_norm <- ks.test(proba_gamma, "pnorm", mean = 100, sd = 10)
print(test_ks_gamma_norm)
cat("\n   H0: Próba pochodzi z rozkładu normalnego N(100,10)\n")
cat("   H1: Próba nie pochodzi z rozkładu normalnego N(100,10)\n")
cat("   p =", round(test_ks_gamma_norm$p.value, 4), "\n   ")
wniosek_p(test_ks_gamma_norm$p.value)
cat("   (Ilustruje Centralne Twierdzenie Graniczne - suma 100 zmiennych Exp zbliża się do normalnego)\n\n")
cat("   ii) Test zgodności z rozkładem Gamma(100, 1):\n")
test_ks_gamma <- ks.test(proba_gamma, "pgamma", shape = 100, scale = 1)
print(test_ks_gamma)
cat("\n   H0: Próba pochodzi z rozkładu Gamma(100,1)\n")
cat("   H1: Próba nie pochodzi z rozkładu Gamma(100,1)\n")
cat("   p =", round(test_ks_gamma$p.value, 4), "\n   ")
wniosek_p(test_ks_gamma$p.value)
cat("\n\n")
cat(paste(rep("=", 80), collapse = ""), "\n")
cat("ZADANIE 3: Test normalności dla danych o mieszkaniach\n")
cat(paste(rep("=", 80), collapse = ""), "\n\n")
cat("Podstawowe statystyki danych:\n")
cat("Cena - średnia:", mean(mieszkania$cena), "odchylenie:", sd(mieszkania$cena), "\n")
cat("Metraż - średnia:", mean(mieszkania$metraz), "odchylenie:", sd(mieszkania$metraz), "\n\n")
# a) Test Shapiro-Wilka dla ceny za m2
cat("a) Test normalności dla ceny za m2:\n")
cena_m2 <- mieszkania$cena / mieszkania$metraz
shapiro_cena_m2 <- shapiro.test(cena_m2)
test_kostka <- function(freq, alpha = 0.05) {
n <- sum(freq)
exp_freq <- rep(n/6, 6)
chi2 <- sum((freq - exp_freq)^2 / exp_freq)
p <- 1 - pchisq(chi2, df = 5)
list(
H0 = "Kostka symetryczna",
H1 = "Kostka niesymetryczna",
statystyka = chi2,
p_value = p,
decyzja = ifelse(p < alpha, "Odrzucamy H0", "Brak podstaw do odrzucenia H0")
)
}
freq <- c(171,200,168,213,226,222)
test_kostka(freq)
chisq.test(freq)
ks_exp <- function(n = 1000, alpha = 0.05) {
x <- rexp(n, rate = 1)
list(
normalny = ks.test(x, "pnorm", mean = 1, sd = 1),
wykladniczy = ks.test(x, "pexp", rate = 1)
)
}
ks_exp()
ks_gamma <- function(n = 1000) {
x <- rgamma(n, shape = 100, scale = 1)
list(
normalny = ks.test(x, "pnorm", mean = 100, sd = 10),
gamma = ks.test(x, "pgamma", shape = 100, scale = 1)
)
}
ks_gamma()
test_normalnosc <- function(x, alpha = 0.05) {
sw <- shapiro.test(x)
list(
H0 = "Rozkład normalny",
H1 = "Rozkład nienormalny",
statystyka = sw$statistic,
p_value = sw$p.value,
decyzja = ifelse(sw$p.value < alpha, "Odrzucamy H0", "Brak podstaw do odrzucenia H0")
)
}
m <- read.csv2("mieszkania.csv")
test_normalnosc(m$Cena / m$Metraz)  # cena za m2
test_normalnosc(m$Metraz)
model_mieszkanie <- function(dane, metraz = 80) {
model <- lm(Cena ~ Metraz, data = dane)
reszty <- residuals(model)
list(
model = summary(model),
normalnosc_reszt = shapiro.test(reszty),
estymacja_80m2 = predict(model, newdata = data.frame(Metraz = metraz))
)
}
m <- read.csv2("mieszkania.csv")
plot(m$Metraz, m$Cena)
abline(lm(Cena ~ Metraz, data = m), col = "red")
model_mieszkanie(m)
b <- read.csv("bakteria.csv")
plot(b$czas, b$masa)
model_log <- lm(log(masa) ~ czas, data = b)
b <- read.csv2("bakteria.csv")
plot(b$czas, b$masa)
model_log <- lm(log(masa) ~ czas, data = b)
summary(model_log)
prognoza_masy <- function(t) {
exp(predict(model_log, newdata = data.frame(czas = t)))
}
prognoza_masy(9)
test_kostka <- function(freq, alpha = 0.05) {
n <- sum(freq)
exp_freq <- rep(n/6, 6)
chi2 <- sum((freq - exp_freq)^2 / exp_freq)
p <- 1 - pchisq(chi2, df = 5)
list(
H0 = "kostka symetryczna",
H1 = "kostka niesymetryczna",
statystyka = chi2,
p_value = p,
decyzja = ifelse(p < alpha, "odrzucamy H0", "brak podstaw do odrzucenia H0")
)
}
freq <- c(171,200,168,213,226,222)
test_kostka(freq)
chisq.test(freq)
